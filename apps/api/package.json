    "@nestjs/platform-express": "^10.2.10",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "helmet": "^7.2.0",
    "nestjs-pino": "^4.6.1",
