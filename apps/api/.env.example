# Backend Environment Variables

# Database
DATABASE_URL=postgresql://cyclist:cycling_dev_password@localhost:5432/cycling_routes

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload (S3/local placeholder)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Redis (for future caching/queues)
REDIS_URL=redis://localhost:6379
