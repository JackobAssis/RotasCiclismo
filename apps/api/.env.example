# =============================================================================
# Cycling Routes Backend - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Available presets: .env.development, .env.staging, .env.production
# =============================================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database (PostgreSQL / Neon) ----
# Local: postgresql://cyclist:password@localhost:5432/cycling_routes
# Neon (pooled): postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ---- JWT Authentication ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ---- File Storage ----
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ---- Redis (optional - for caching/queues) ----
REDIS_URL=

# ---- Rate Limiting (defaults) ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
