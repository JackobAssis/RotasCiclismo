# =============================================================================
# Production Environment
# =============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

DATABASE_URL=postgresql://cyclist:production_password@prod-db.neon.tech/cycling_routes?sslmode=require

JWT_SECRET=change-this-to-a-real-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-another-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=https://cycling.app

STORAGE_TYPE=local
UPLOAD_DIR=./uploads

REDIS_URL=
