# =============================================================================
# Staging Environment
# =============================================================================

NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://cyclist:staging_password@staging-db.neon.tech/cycling_routes?sslmode=require

JWT_SECRET=staging-jwt-secret-change-in-production-min-32-char!!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=staging-refresh-secret-change-in-production-min-32!
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=https://staging.cycling.app

STORAGE_TYPE=local
UPLOAD_DIR=./uploads

REDIS_URL=
